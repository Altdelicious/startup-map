{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/altdelicious/startup-map/schema/city.schema.json",
  "title": "City config",
  "description": "data/cities/<city>/city.yaml. Coordinates are [lat, lng]; bbox is [south, west, north, east].",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "country", "postcode_format", "center", "zoom", "bbox", "areas"],
  "properties": {
    "id": { "$ref": "startup.schema.json#/properties/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2" },
    "postcode_format": { "type": "string", "enum": ["uk", "fr"] },
    "center": { "$ref": "#/$defs/latLng" },
    "zoom": { "type": "number", "minimum": 1, "maximum": 18 },
    "bbox": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4,
      "description": "[south, west, north, east]"
    },
    "maintainers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$" },
      "description": "GitHub handles"
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "center"],
        "properties": {
          "id": { "$ref": "startup.schema.json#/properties/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "center": { "$ref": "#/$defs/latLng", "description": "Where area-only pins are placed" }
        }
      }
    }
  },
  "$defs": {
    "latLng": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "description": "[lat, lng]"
    }
  }
}
